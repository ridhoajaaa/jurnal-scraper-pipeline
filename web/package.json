{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./app.css --watch",
    "start": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.2.4",
    "resend": "^6.9.3",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.2.1",
    "@tailwindcss/cli": "^4.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.1.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "server.js",
      "logger.js"
    ]
  }
}
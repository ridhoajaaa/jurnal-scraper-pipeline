# ============================================================
# LitAssist — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your actual keys
# ============================================================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/literature_assistant

# Session encryption — USE A STRONG RANDOM STRING (64+ chars)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Google Gemini AI — get from https://aistudio.google.com/
GEMINI_API_KEY=

# Resend email — get from https://resend.com/
RESEND_API_KEY=

# Public URL of your deployment (used for email links, CORS, etc.)
APP_URL=http://localhost:3000

# Optional: Ngrok auth token for tunneling
NGROK_AUTHTOKEN=
